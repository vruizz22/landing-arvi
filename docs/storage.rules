rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Material de redes de /gestion: solo usuarios con sesión iniciada pueden ver y subir (máx. 500 MB por archivo)
    match /material/{all=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.size < 500 * 1024 * 1024;
      allow update, delete: if false;
    }
  }
}
