rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo los 3 administradores de ARVI HAPPY pueden leer y escribir reservas.
    match /reservas/{id} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['arvi.juegos@gmail.com', 'coniadmin@arvi.cl', 'ajienciapica@gmail.com'];
    }
    // Web de gestión (arvi.cl/gestion): eventos, equipo y cobranza. Mismos 3 usuarios.
    match /{coleccion}/{id} {
      allow read, write: if coleccion.matches('gestion_.*')
        && request.auth != null
        && request.auth.token.email in ['arvi.juegos@gmail.com', 'coniadmin@arvi.cl', 'ajienciapica@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
