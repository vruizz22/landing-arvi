rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo los 3 administradores de ARVI HAPPY pueden leer y escribir reservas.
    match /reservas/{id} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['arviadmin@arvi.cl', 'coniadmin@arvi.cl', 'bastianadmin@arvi.cl'];
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
