---
import { Image } from 'astro:assets'
import ArviLogo from '@assets/logo_arvi.svg'
import { Icon } from 'astro-icon/components'
---

<footer class="bg-arvi-background text-arvi-text relative">
  <!-- Imagen de fondo con overlay y mask gradient -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-[url('/images/footer.webp')] bg-cover bg-center"></div>
    <div class="bg-arvi-text absolute inset-0 opacity-60"></div>
  </div>

  <div class="relative z-10 container mx-auto px-4 py-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
      <!-- Información de Contacto -->
      <div class="footer-info">
        <div class="mb-8">
          <div class="mb-4">
            <Image
              src={ArviLogo}
              alt="ARVI Entretenciones"
              width={150}
              class="mb-4 transition-transform duration-300 hover:scale-105"
            />
            <h3
              class="text-arvi-primary font-heading after:bg-arvi-primary relative text-2xl after:block after:h-0.5 after:w-0 after:transition-all after:duration-300 after:content-[''] hover:after:w-48"
            >
              ARVI Entretenciones
            </h3>
          </div>
          <p class="mb-6 max-w-sm text-white">
            Más de 19 años creando experiencias inolvidables con un enfoque sustentable y
            responsable.
          </p>
        </div>

        <div class="space-y-6">
          <div class="flex items-start space-x-4">
            <Icon
              name="mdi:map-marker"
              class="text-arvi-primary mt-1 h-6 w-6 flex-shrink-0 transform transition-all duration-300 hover:scale-125 hover:rotate-6"
            />
            <div>
              <h4
                class="text-arvi-primary font-heading mb-1 transform cursor-default transition-transform duration-300 hover:translate-x-1"
              >
                Ubicación
              </h4>
              <p class="text-arvi-background">Atendemos a nivel nacional</p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <Icon
              name="mdi:phone"
              class="text-arvi-primary mt-1 h-6 w-6 flex-shrink-0 transform transition-all duration-300 hover:scale-125 hover:rotate-6"
            />
            <div>
              <h4
                class="text-arvi-primary font-heading mb-1 transform cursor-default transition-transform duration-300 hover:translate-x-1"
              >
                Contacto
              </h4>
              <p class="text-arvi-background">
                WhatsApp: +56 9 8808 2320<br />
              </p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <Icon
              name="mdi:clock"
              class="text-arvi-primary mt-1 h-6 w-6 flex-shrink-0 transform transition-all duration-300 hover:scale-125 hover:rotate-6"
            />
            <div>
              <h4
                class="text-arvi-primary font-heading mb-1 transform cursor-default transition-transform duration-300 hover:translate-x-1"
              >
                Horarios
              </h4>
              <p class="text-arvi-background">
                Lun - Vie: 9:30 - 18:30<br />
                Sáb - Dom: 9:30 - 16:00
              </p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <Icon
              name="mdi:instagram"
              class="text-arvi-primary mt-1 h-6 w-6 flex-shrink-0 transform transition-all duration-300 hover:scale-125 hover:rotate-6"
            />
            <div>
              <h4
                class="text-arvi-primary font-heading mb-1 transform cursor-default transition-transform duration-300 hover:translate-x-1"
              >
                Síguenos
              </h4>
              <a
                href="https://www.instagram.com/arvi.cl/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-arvi-background hover:text-arvi-primary group inline-flex items-center transition-all duration-300"
              >
                @arvi.cl
                <span
                  class="ml-1 inline-block transform opacity-0 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100"
                  >→</span
                >
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Formulario de Contacto -->
      <div id="contact">
        <div class="bg-arvi-background text-arvi-text rounded-lg shadow-xl">
          <div class="p-6">
            <h3
              class="font-heading relative mb-2 transform text-center text-2xl transition-transform duration-300 hover:-rotate-1"
            >
              <span class="inline-block transform transition-transform duration-200 hover:scale-110"
                ><Icon name="mdi:comment-text" class="inline h-6 w-6" /></span
              > Solicita tu Cotización
            </h3>
            <p class="mb-6 text-center text-gray-600">
              Cuéntanos sobre tu evento y te contactaremos en menos de 24 horas
            </p>

            <form id="contactForm" class="space-y-4">
              <div>
                <label for="name" class="mb-2 block text-sm font-medium"> Nombre completo </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  placeholder="Tu nombre completo"
                  required
                  class="focus:ring-arvi-primary/60 hover:border-arvi-primary/50 w-full rounded-md border border-gray-300 px-4 py-2 transition-all duration-300 hover:shadow-sm focus:ring-2 focus:outline-none"
                />
              </div>

              <div>
                <label for="eventDate" class="mb-2 block text-sm font-medium">
                  Fecha del evento
                </label>
                <input
                  id="eventDate"
                  name="eventDate"
                  type="date"
                  required
                  class="focus:ring-arvi-primary/60 hover:border-arvi-primary/50 w-full rounded-md border border-gray-300 px-4 py-2 transition-all duration-300 hover:shadow-sm focus:ring-2 focus:outline-none"
                />
              </div>

              <div>
                <label for="message" class="mb-2 block text-sm font-medium">
                  Cuéntanos sobre tu evento
                </label>
                <textarea
                  id="message"
                  name="message"
                  placeholder="Tipo de evento, cantidad de personas, ubicación, servicios de interés..."
                  rows="4"
                  required
                  class="focus:ring-arvi-primary/60 hover:border-arvi-primary/50 w-full rounded-md border border-gray-300 px-4 py-2 transition-all duration-300 hover:shadow-sm focus:ring-2 focus:outline-none"
                ></textarea>
              </div>

              <button
                type="submit"
                class="bg-arvi-primary hover:bg-arvi-primary/90 text-arvi-background font-heading hover:shadow-arvi-primary/20 group relative w-full transform overflow-hidden rounded-md py-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
              >
                <span
                  class="absolute inset-0 -translate-x-full transform bg-white/10 transition-transform duration-500 group-hover:translate-x-0"
                ></span>
                <span class="relative flex items-center justify-center gap-2">
                  <span class="transform transition-transform duration-300 group-hover:scale-110"
                    ><Icon name="mdi:whatsapp" class="h-6 w-6" /></span
                  >
                  Enviar por WhatsApp
                </span>
              </button>
            </form>

            <p class="text-arvi-text mt-4 text-center text-xs">
              Al enviar este formulario, serás redirigido a WhatsApp con tu mensaje pre-cargado
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Sección inferior -->
    <div class="mt-12 border-t border-t-stone-50 pt-8">
      <div class="flex flex-col items-center justify-between space-y-4 md:flex-row md:space-y-0">
        <div class="text-center md:text-left">
          <div class="flex items-center gap-2">
            <p class="text-arvi-background">Desarrollada por</p>
            <a
              href="https://github.com/vruizz22/landing-arvi"
              target="_blank"
              rel="noopener noreferrer"
              class="text-arvi-background hover:text-arvi-primary group flex items-center gap-1 transition-all duration-300"
            >
              <Icon
                name="mdi:github"
                class="h-5 w-5 transition-transform duration-300 group-hover:scale-110"
              />
              <span class="font-medium">vruizz22</span>
            </a>
          </div>
        </div>

        <div class="text-center md:text-right">
          <p class="text-arvi-background group cursor-default">
            <span
              class="inline-block transform transition-transform duration-300 group-hover:scale-105"
              >©</span
            > 2025 ARVI Entretenciones. Todos los derechos reservados.
          </p>
          <p
            class="text-arvi-background mt-1 cursor-default text-sm transition-all duration-300 hover:tracking-wide"
          >
            Empresa certificada en seguridad y medio ambiente
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  // Función para manejar el envío del formulario
  document.getElementById('contactForm')?.addEventListener('submit', function (e) {
    e.preventDefault()

    const name = (document.getElementById('name') as HTMLInputElement).value
    const eventDate = (document.getElementById('eventDate') as HTMLInputElement).value
    const message = (document.getElementById('message') as HTMLTextAreaElement).value

    // Formatear la fecha si es necesario
    const formattedDate = new Date(eventDate).toLocaleDateString('es-CL')

    // formatear mensaje y nombre para borrar espacios finales
    const trimmedName = name.trim()
    const trimmedMessage = message.trim()

    // Construir el mensaje para WhatsApp
    const whatsappMessage = `Hola! Mi nombre es ${trimmedName}. Mi evento es el ${formattedDate}. ${trimmedMessage}`

    // Abrir WhatsApp con el mensaje
    window.open(`https://wa.me/56988082320?text=${encodeURIComponent(whatsappMessage)}`, '_blank')
  })
</script>
