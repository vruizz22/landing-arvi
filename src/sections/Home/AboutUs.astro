---
import CardImage from '@components/ui/CardImage.astro'
import CardDropText from '@components/ui/CardDropText.astro'
import PopUp from '@components/ui/PopUp.astro'
import { Icon } from 'astro-icon/components'
import InstagramFeed from '@components/InstagramFeed.astro'
import ImagesCarousel from '@components/ui/ImagesCarousel.astro'
---

<section class="bg-arvi-background py-16" id="nosotros">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 text-center">
        <h2 class="font-heading text-arvi-text mb-4 text-4xl md:text-5xl">
          Conoce
          <span class="text-arvi-primary">ARVI</span>
          <span class="text-arvi-secondary">Entretenciones</span>
        </h2>
        <p class="text-arvi-text/80 mx-auto max-w-2xl text-lg">
          Llevamos más de 19 años creando experiencias inolvidables con un enfoque sustentable y
          responsable.
        </p>
      </div>

      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
        <div>
          <div class="space-y-6">
            <div
              class="group hover:bg-arvi-background/80 flex items-start space-x-4 rounded-lg p-2 transition-all duration-300 hover:shadow-md"
            >
              <div
                class="bg-arvi-secondary text-arvi-background flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full transition-transform duration-300 group-hover:scale-110 group-hover:shadow-md"
              >
                <Icon name="mdi:map-marker" class="h-6 w-6" />
              </div>
              <div>
                <h4
                  class="font-heading text-arvi-text group-hover:text-arvi-secondary mb-2 text-xl transition-colors duration-300"
                >
                  Cobertura Nacional
                </h4>
                <p
                  class="text-arvi-text/70 group-hover:text-arvi-text/90 transition-colors duration-300"
                >
                  Desde Arica a Punta Arenas, llevamos eventos a municipios, colegios, empresas,
                  festivales, eventos corporativos, ferias temáticas y celebraciones especiales en
                  todo Chile.
                </p>
              </div>
            </div>

            <div
              class="group hover:bg-arvi-background/80 flex items-start space-x-4 rounded-lg p-2 transition-all duration-300 hover:shadow-md"
            >
              <div
                class="bg-arvi-secondary text-arvi-background flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full transition-transform duration-300 group-hover:scale-110 group-hover:shadow-md"
              >
                <Icon name="mdi:leaf" class="h-6 w-6" />
              </div>
              <div>
                <h4
                  class="font-heading text-arvi-text group-hover:text-arvi-secondary mb-2 text-xl transition-colors duration-300"
                >
                  Enfoque en Juegos Mecánicos y Eco-Sustentables
                </h4>
                <p
                  class="text-arvi-text/70 group-hover:text-arvi-text/90 transition-colors duration-300"
                >
                  Nuestros juegos sustentables educan y enseñan a los niños sobre ecología y energía
                  renovable, ofreciendo integración medioambiental para contribuir al cuidado del
                  planeta.
                </p>
              </div>
            </div>

            <div
              class="group hover:bg-arvi-background/80 flex items-start space-x-4 rounded-lg p-2 transition-all duration-300 hover:shadow-md"
            >
              <div
                class="bg-arvi-secondary text-arvi-background flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full transition-transform duration-300 group-hover:scale-110 group-hover:shadow-md"
              >
                <Icon name="mdi:factory" class="h-6 w-6" />
              </div>
              <div>
                <h4
                  class="font-heading text-arvi-text group-hover:text-arvi-secondary mb-2 text-xl transition-colors duration-300"
                >
                  Fabricación Nacional
                </h4>
                <p
                  class="text-arvi-text/70 group-hover:text-arvi-text/90 transition-colors duration-300"
                >
                  Todos nuestros juegos son de fabricación nacional, respaldados por entidades
                  internacionales y reconocidos por comunidades chilenas. Al ser fabricantes,
                  tenemos la estructura necesaria para eventos rápidos y exitosos.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 items-start gap-4 sm:grid-cols-2">
          <CardDropText
            icon="mdi:security"
            title="Seguridad"
            subtitle="Equipos certificados y personal capacitado"
            dropText="ARVI se ha consolidado como un referente en la fabricación y arriendo de juegos mecánicos y sustentables. Nuestra misión incluye el desarrollo de atracciones sustentables, asegurando que el entretenimiento que proporcionamos sea responsable con el medio ambiente."
            iconColor="text-arvi-secondary"
            bgColorHover="bg-arvi-secondary/10 border-arvi-secondary/20 hover:bg-arvi-secondary/20"
          />

          <CardDropText
            icon="mdi:flash"
            title="Rapidez"
            subtitle="Montaje eficiente en tiempo récord"
            dropText="Somos líderes en el mercado. Todos nuestros juegos de fabricación nacional, respaldados y destacados por entidades internacionales y por comunidades chilenas. Proveedores de Gremio internacional EEUU en fabricaciones. Asociación Global de la Industria de las Atracciones - IAAPA América Latina, Caribe. Corfo con proyectos de innovación."
            iconColor="text-arvi-primary"
            bgColorHover="bg-arvi-primary/10 border-arvi-primary/20 hover:bg-arvi-primary/20"
          />

          <CardDropText
            icon="mdi:handshake"
            title="Confianza"
            subtitle="Respaldo y garantía en cada evento"
            dropText="Realizamos celebraciones en municipios, colegios, empresas, festivales, eventos corporativos, ferias temáticas, celebraciones del día del niño, fiestas de fin de año, etc. Al ser fabricantes contamos con la estructura necesaria para hacer tu evento de forma rápida y exitosa."
            iconColor="text-arvi-accent"
            bgColorHover="bg-arvi-accent/10 border-arvi-accent/20 hover:bg-arvi-accent/20"
          />

          <CardDropText
            icon="mdi:star"
            title="Calidad"
            subtitle="Equipos premium y servicio excepcional"
            dropText="Nuestros juegos sustentables están pensados como nuevos proyectos para la conciencia sobre la necesidad de las actividades humanas interactivas sean respetuosas con el medio ambiente. Estos educan y enseñan a los niños en materia de ecología y energía renovable, ofreciendo además la integración medioambiental y ecológica para contribuir al cuidado del planeta. Todo al alcance también a aquellos espacios de ocio donde disfrutamos tanto niños como adultos."
            iconColor="text-arvi-primary"
            bgColorHover="bg-arvi-primary/10 border-arvi-secondary/20 hover:bg-arvi-primary/20"
          />
        </div>
      </div>

      <!-- Sección de Nuestros Productos con Carousel -->
      <h2 class="font-heading text-arvi-text mt-20 mb-12 text-center text-4xl md:text-5xl">
        Nuestros
        <span class="text-arvi-secondary">Productos</span>
        <span class="text-arvi-primary">Destacados</span>
      </h2>

      <!-- Son 5 cards del componente CARD, cada una contiene 1 juego 
      1. Barco Pirata
      2. Globos Samba
      3. Canopy
      4. Tagada
      5. Rueda 
      -->

      <!-- Primeras 4 cards en matriz 2x2 -->
      <div class="mb-8 grid grid-cols-1 justify-items-center gap-6 sm:grid-cols-2">
        <PopUp
          images={[
            '/images/juegos/barco_pirata/barco_pirata.jpg',
            '/images/juegos/barco_pirata/barco_pirata_2.jpg',
            '/images/juegos/barco_pirata/barco_pirata_3.jpg',
          ]}
          alt="Barco Pirata"
          showArrows={true}
          showDots={true}
          autoplay={true}
          autoplayInterval={3000}
        >
          <CardImage
            images={[
              '/images/juegos/barco_pirata/barco_pirata.jpg',
              '/images/juegos/barco_pirata/barco_pirata_2.jpg',
              '/images/juegos/barco_pirata/barco_pirata_3.jpg',
            ]}
            title="Barco Pirata"
            description="La atracción estrella que garantiza diversión para todas las edades."
            autoplayInterval={3000}
            animationType="slide"
            showDots={false}
            showArrows={true}
          />
        </PopUp>

        <PopUp
          images={[
            '/images/juegos/globos_samba/globos_samba.jpg',
            '/images/juegos/globos_samba/globos_samba_2.jpg',
            '/images/juegos/globos_samba/globos_samba_3.jpg',
          ]}
          alt="Globos Samba"
          showArrows={true}
          showDots={true}
          autoplay={true}
          autoplayInterval={3000}
        >
          <CardImage
            images={[
              '/images/juegos/globos_samba/globos_samba.jpg',
              '/images/juegos/globos_samba/globos_samba_2.jpg',
              '/images/juegos/globos_samba/globos_samba_3.jpg',
            ]}
            title="Globos Samba"
            description="Emoción y adrenalina en cada vuelta, ideal para los amantes de la velocidad."
            autoplayInterval={3000}
            animationType="slide"
            showDots={false}
            showArrows={true}
          />
        </PopUp>

        <PopUp
          images={[
            '/images/juegos/rueda/rueda.jpg',
            '/images/juegos/rueda/rueda_2.jpg',
            '/images/juegos/rueda/rueda_3.jpg',
          ]}
          alt="Rueda"
          showArrows={true}
          showDots={true}
          autoplay={true}
          autoplayInterval={3000}
        >
          <CardImage
            images={[
              '/images/juegos/rueda/rueda.jpg',
              '/images/juegos/rueda/rueda_2.jpg',
              '/images/juegos/rueda/rueda_3.jpg',
            ]}
            title="Rueda"
            description="Disfruta de vistas panorámicas mientras te relajas en esta icónica atracción."
            autoplayInterval={3000}
            animationType="slide"
            showDots={false}
            showArrows={true}
          />
        </PopUp>

        <PopUp
          images={[
            '/images/juegos/tagada/tagada.jpg',
            '/images/juegos/tagada/tagada_2.jpg',
            '/images/juegos/tagada/tagada_3.jpg',
            '/images/juegos/tagada/tagada_4.jpg',
            '/images/juegos/tagada/tagada_5.jpg',
          ]}
          alt="Tagada"
          showArrows={true}
          showDots={true}
          autoplay={true}
          autoplayInterval={3000}
        >
          <CardImage
            images={[
              '/images/juegos/tagada/tagada.jpg',
              '/images/juegos/tagada/tagada_2.jpg',
              '/images/juegos/tagada/tagada_3.jpg',
              '/images/juegos/tagada/tagada_4.jpg',
              '/images/juegos/tagada/tagada_5.jpg',
            ]}
            title="Tagada"
            description="Diversión sin fin con giros y vueltas que harán vibrar a todos"
            autoplayInterval={3000}
            animationType="slide"
            showDots={false}
            showArrows={true}
          />
        </PopUp>
      </div>

      <!-- Quinta card centrada debajo -->
      <!--<div class="flex justify-center mb-12">
        <CardImage 
          src="/images/rueda.jpg"
          alt="Rueda"
          title="Rueda"
          description="Disfruta de vistas panorámicas mientras te relajas en esta icónica atracción."
          width="w-full"
        />
      </div>
      -->
      <!-- Sección de Nuestro Equipo con Carousel -->
      <h2 class="font-heading text-arvi-text mt-20 mb-4 text-4xl md:text-5xl">
        Nuestro
        <span class="text-arvi-secondary">Equipo</span>
        <span class="text-arvi-primary">ARVI</span>
      </h2>

      <!-- Carousel de imágenes del equipo -->
      <div class="mt-16">
        <PopUp
          images={['/images/team.jpg']}
          alt="Equipo ARVI Entretenciones"
          showArrows={true}
          showDots={true}
          autoplay={true}
          autoplayInterval={2000}
        >
          <ImagesCarousel
            images={['/images/team.jpg']}
            width="100%"
            height="400px"
            autoplayInterval={2000}
            animationType="fade"
            className="shadow-lg"
            alt="Equipo ARVI Entretenciones"
            showDots={true}
            showArrows={true}
          />
        </PopUp>
      </div>

      <!-- Carrusel de Instagram -->
      <div class="relative mt-24 mb-12">
        <!-- Fondo decorativo para la sección de Instagram -->
        <div
          class="from-arvi-background to-arvi-primary/5 absolute inset-0 z-0 -mx-4 -my-8 rounded-3xl bg-gradient-to-b"
        >
        </div>
        <!-- Patrón decorativo -->
        <div class="absolute top-0 right-0 h-32 w-32 opacity-10">
          <Icon name="mdi:instagram" class="text-arvi-primary h-full w-full" />
        </div>
        <!-- Contenido del carrusel -->
        <div class="relative z-10">
          <InstagramFeed />
        </div>
      </div>
    </div>
  </div>
</section>
