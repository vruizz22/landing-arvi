---
import Card from '@components/ui/Card.astro'
import CardContent from '@components/ui/CardContent.astro'
import { Icon } from 'astro-icon/components'

// Datos de los servicios
const services = [
  {
    title: 'Arriendo Juegos Mecánicos',
    description: 'Carruseles, mini montañas rusas, autos chocadores y más para todas las edades',
    icon: 'tabler:wheel',
    iconColor: 'text-arvi-primary',
    features: ['Equipos certificados', 'Operador incluido', 'Seguro de responsabilidad'],
    bgColor: 'bg-arvi-primary/10',
    borderColor: 'border-arvi-primary/20',
  },
  {
    title: 'Juegos complementarios y deportivos',
    description: 'Castillos, toboganes y juegos inflables para la diversión más segura',
    icon: 'streamline-freehand:amusement-park-castle',
    iconColor: 'text-arvi-accent',
    features: ['Desinfección garantizada', 'Supervisión incluida', 'Materiales premium'],
    bgColor: 'bg-arvi-accent/10',
    borderColor: 'border-arvi-accent/20',
  },
  {
    title: 'Proyectos Sustentables',
    description: 'Entretenimiento eco-friendly con energías renovables y materiales reciclables',
    icon: 'mdi:leaf',
    iconColor: 'text-arvi-secondary',
    features: ['Energía solar', 'Materiales eco', 'Certificación verde'],
    bgColor: 'bg-arvi-secondary/10',
    borderColor: 'border-arvi-secondary/30',
  },
  {
    title: 'Eventos Corporativos',
    description: 'Soluciones integrales para team building y celebraciones empresariales',
    icon: 'mdi:office-building',
    iconColor: 'text-arvi-secondary',
    features: ['Logística completa', 'Coordinación profesional', 'Actividades personalizadas'],
    bgColor: 'bg-arvi-secondary/10',
    borderColor: 'border-arvi-secondary/20',
  },
  {
    title: 'Celebraciones Municipales',
    description: 'Eventos masivos para fiestas patrias, aniversarios y celebraciones públicas',
    icon: 'mdi:party-popper',
    iconColor: 'text-arvi-primary',
    features: ['Capacidad masiva', 'Documentación de Seguridad', 'Logística asegurada'],
    bgColor: 'bg-arvi-primary/10',
    borderColor: 'border-arvi-primary/20',
  },
  {
    title: 'Eventos Escolares',
    description: 'Diversión educativa y segura para colegios y jardines infantiles',
    icon: 'mdi:school',
    iconColor: 'text-arvi-accent',
    features: [
      'Actividades de tour escolares',
      'Seguridad y Montaje reforzados',
      'Precios y Convenios especiales',
    ],
    bgColor: 'bg-arvi-accent/10',
    borderColor: 'border-arvi-accent/20',
  },
]
---

<section class="bg-arvi-background2 py-16" id="servicios">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 text-center">
        <h2 class="font-heading text-arvi-text mb-4 text-4xl md:text-5xl">
          Nuestros
          <span class="text-arvi-primary">Servicios</span>
        </h2>
        <p class="text-arvi-text/80 mx-auto max-w-2xl text-lg">
          Soluciones completas de entretenimiento para todo tipo de eventos. Desde pequeñas
          celebraciones hasta grandes festivales.
        </p>
      </div>

      <div class="mb-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <div class="service-card group">
              <Card
                className={`${service.bgColor} ${service.borderColor} h-full border-2 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl`}
              >
                <CardContent className="text-center p-6">
                  <div class="mb-6 flex justify-center">
                    <div class="border-arvi-background flex h-20 w-20 items-center justify-center rounded-full border-2 bg-white shadow-md transition-transform duration-500 group-hover:scale-110">
                      <Icon
                        name={service.icon}
                        class={`h-12 w-12 ${service.iconColor} group-hover:text-arvi-primary transition-colors duration-300`}
                      />
                    </div>
                  </div>
                  <h3 class="font-heading text-arvi-text group-hover:text-arvi-secondary mb-3 text-xl transition-colors duration-300 md:text-2xl">
                    {service.title}
                  </h3>
                  <p class="text-arvi-text/80 mb-6 text-sm">{service.description}</p>
                  <ul class="mb-6 space-y-3 text-left">
                    {service.features.map((feature) => (
                      <li class="text-arvi-text/90 group-hover:text-arvi-text flex items-start text-sm transition-colors duration-300">
                        <div class="bg-arvi-accent group-hover:bg-arvi-primary mt-1.5 mr-3 h-2 w-2 flex-shrink-0 rounded-full transition-colors duration-300" />
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                </CardContent>
              </Card>
            </div>
          ))
        }
      </div>

      <!-- Garantías de servicio -->
      <div
        class="from-arvi-primary/5 to-arvi-secondary/5 border-arvi-primary/10 mt-24 rounded-2xl border bg-gradient-to-r via-white px-6 py-12 shadow-sm"
      >
        <h3 class="font-heading text-arvi-text mb-10 text-center text-3xl md:text-4xl">
          Nuestra <span class="text-arvi-secondary">Garantía</span> de <span
            class="text-arvi-primary">Calidad</span
          >
        </h3>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-4 lg:grid-cols-4 lg:gap-8">
          <div
            class="group hover:border-arvi-primary/10 rounded-xl border border-transparent p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-md"
          >
            <div
              class="bg-arvi-primary/10 group-hover:bg-arvi-primary/20 mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full transition-colors duration-300"
            >
              <Icon name="mdi:clock-fast" class="text-arvi-primary h-8 w-8" />
            </div>
            <h4
              class="font-heading text-arvi-text group-hover:text-arvi-primary mb-2 text-lg transition-colors duration-300"
            >
              Montaje Rápido
            </h4>
            <p
              class="text-arvi-text/70 group-hover:text-arvi-text/90 text-sm transition-colors duration-300"
            >
              2-4 horas promedio para instalación completa
            </p>
          </div>

          <div
            class="group hover:border-arvi-secondary/10 rounded-xl border border-transparent p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-md"
          >
            <div
              class="bg-arvi-secondary/10 group-hover:bg-arvi-secondary/20 mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full transition-colors duration-300"
            >
              <Icon name="mdi:shield-check" class="text-arvi-secondary h-8 w-8" />
            </div>
            <h4
              class="font-heading text-arvi-text group-hover:text-arvi-secondary mb-2 text-lg transition-colors duration-300"
            >
              100% Seguro
            </h4>
            <p
              class="text-arvi-text/70 group-hover:text-arvi-text/90 text-sm transition-colors duration-300"
            >
              Todas nuestras certificaciones al día
            </p>
          </div>

          <div
            class="group hover:border-arvi-accent/10 rounded-xl border border-transparent p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-md"
          >
            <div
              class="bg-arvi-accent/10 group-hover:bg-arvi-accent/20 mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full transition-colors duration-300"
            >
              <Icon name="mdi:account-group" class="text-arvi-accent h-8 w-8" />
            </div>
            <h4
              class="font-heading text-arvi-text group-hover:text-arvi-accent mb-2 text-lg transition-colors duration-300"
            >
              Personal Capacitado
            </h4>
            <p
              class="text-arvi-text/70 group-hover:text-arvi-text/90 text-sm transition-colors duration-300"
            >
              Operadores con experiencia y certificaciones
            </p>
          </div>

          <div
            class="group hover:border-arvi-primary/10 rounded-xl border border-transparent p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-md"
          >
            <div
              class="bg-arvi-secondary/10 group-hover:bg-arvi-secondary/20 mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full transition-colors duration-300"
            >
              <Icon name="mdi:leaf-circle" class="text-arvi-secondary h-8 w-8" />
            </div>
            <h4
              class="font-heading text-arvi-text group-hover:text-arvi-secondary mb-2 text-lg transition-colors duration-300"
            >
              Energía Sustentable
            </h4>
            <p
              class="text-arvi-text/70 group-hover:text-arvi-text/90 text-sm transition-colors duration-300"
            >
              Opciones eco-amigables para tu evento
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
