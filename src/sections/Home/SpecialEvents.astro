---
import { Icon } from 'astro-icon/components'
import Button from '@components/ui/Button.astro'
import Card from '@components/ui/Card.astro'
import CardContent from '@components/ui/CardContent.astro'
import PopUp from '@components/ui/PopUp.astro'
import CardImage from '@components/ui/CardImage.astro'
---

<section
  class="from-arvi-primary/60 via-arvi-background to-arvi-secondary/60 relative bg-gradient-to-br py-16"
>
  {/* Elementos decorativos de fondo */}
  <div class="absolute inset-0 opacity-5">
    <div class="bg-arvi-primary absolute top-10 left-10 h-32 w-32 rounded-2xl blur-3xl"></div>
    <div class="bg-arvi-secondary absolute right-10 bottom-10 h-40 w-40 rounded-2xl blur-3xl"></div>
    <div
      class="bg-arvi-accent absolute top-1/2 left-1/2 h-48 w-48 -translate-x-1/2 -translate-y-1/2 transform rounded-2xl blur-3xl"
    >
    </div>
  </div>

  <div class="relative z-10 container mx-auto px-4">
    {/* Encabezado con elementos festivos */}
    <div class="mb-12 text-center">
      <div class="mb-4 flex items-center justify-center gap-2">
        <Icon name="lucide:sparkles" class="text-arvi-primary h-8 w-8 animate-pulse" />
        <div
          class="bg-arvi-primary text-arvi-background border-arvi-primary animate-bounce rounded-2xl border px-4 py-2"
        >
          <Icon name="lucide:tent" class="mr-1 inline-block h-5 w-5" /> EVENTO ESPECIAL <Icon
            name="lucide:tent"
            class="ml-1 inline-block h-5 w-5"
          />
        </div>
        <Icon name="lucide:sparkles" class="text-arvi-primary h-8 w-8 animate-pulse" />
      </div>

      <h2 class="font-heading text-arvi-text mb-6 text-5xl md:text-6xl">
        ¡<span class="text-arvi-primary">ARVI</span> en
        <span class="text-blue-500">El</span>
        <span class="text-arvi-secondary">Quisco</span>!
      </h2>

      <p class="text-arvi-text/80 mx-auto max-w-3xl text-xl">
        Te invitamos a disfrutar este verano con nosotros en la hermosa
        <span class="text-arvi-secondary font-bold"> Playa El Quisco</span>
      </p>
    </div>

    {/* Tarjeta de evento principal */}
    <div class="mx-auto mb-16 max-w-6xl">
      <Card
        customClass="overflow-hidden border-2 border-arvi-primary/30 shadow-2xl bg-gradient-to-r from-white via-arvi-background/30 to-white hover:shadow-lg transition-all duration-300 hover:-translate-y-1"
      >
        <CardContent customClass="p-0">
          <div class="grid gap-0 md:grid-cols-2">
            {/* Detalles del evento */}
            <div class="space-y-6 p-8">
              <div class="flex items-center gap-3">
                <div class="h-3 w-3 animate-pulse rounded-2xl bg-red-500"></div>
                <div class="rounded-2xl bg-red-500 px-3 py-1 text-sm text-white">
                  🔴 EN VIVO AHORA
                </div>
              </div>

              <div>
                <h3 class="font-heading text-arvi-text mb-3 text-2xl">ARVI en El Quisco 2026</h3>
                <p class="text-arvi-text/70 mb-4">
                  Disfruta el verano con los mejores juegos mecánicos, inflables gigantes y
                  entretenimiento familiar en la costa.
                </p>
              </div>

              <div class="space-y-4">
                <div class="text-arvi-text/80 flex items-center gap-3">
                  <Icon name="lucide:map-pin" class="text-arvi-secondary h-5 w-5" />
                  <span>El Quisco, Chile</span>
                </div>

                <div class="text-arvi-text/80 flex items-center gap-3">
                  <Icon name="lucide:calendar" class="text-arvi-secondary h-5 w-5" />
                  <span>3 de Enero - 1 de Marzo, 2026</span>
                </div>

                <div class="text-arvi-text/80 flex items-center gap-3">
                  <Icon name="lucide:users" class="text-arvi-secondary h-5 w-5" />
                  <span>Para toda la familia</span>
                </div>
              </div>

              <div class="flex flex-col gap-4 sm:flex-row">
                <a
                  href="https://wa.me/56988082320?text=¡Hola!%20Me%20interesa%20saber%20más%20sobre%20ARVI%20en%20El%20Quisco.%20¿Podrían%20darme%20más%20información?"
                  target="_blank"
                  class="bg-arvi-primary hover:bg-arvi-primary/90 text-arvi-background flex flex-1 items-center justify-center rounded-2xl px-4 py-2 transition-all duration-300 hover:-translate-y-1"
                >
                  <Icon name="lucide:message-circle" class="mr-5 h-7 w-9" /> ¡Quiero participar!
                </a>
                <a
                  href="https://www.google.com/maps/place/El+Quisco,+Valparaíso/@-33.3963,-71.6924,14z"
                  target="_blank"
                  class="bg-arvi-secondary text-arvi-background hover:bg-arvi-secondary flex flex-1 items-center justify-center rounded-2xl px-4 py-2 transition-all duration-300 hover:-translate-y-1 hover:text-white"
                >
                  <Icon name="lucide:map-pin" class="mr-5 h-7 w-9" /> Ver ubicación
                </a>
              </div>
            </div>

            {/* Sección visual - Reemplazado por imagen de El Quisco */}
            <div class="relative h-full min-h-[300px]">
              <img
                src="/images/quisco.jpg"
                alt="ARVI en El Quisco - Verano 2026"
                class="absolute inset-0 h-full w-full rounded-2xl object-cover"
              />
            </div>
          </div>
        </CardContent>
      </Card>
    </div>

    {/* Eventos Realizados */}
    <div class="text-center">
      <h3 class="font-heading text-arvi-text mb-16 text-5xl">
        Eventos <span class="text-arvi-secondary">Realizados</span> por <span
          class="text-arvi-primary">ARVI</span
        >
      </h3>

      <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-2">
        <!-- Chile Lindo 2025 - Vitacura -->
        <PopUp
          images={[
            '/images/eventos/chile-lindo/chile-lindo-1.jpg',
            '/images/eventos/chile-lindo/chile-lindo-2.jpg',
            '/images/eventos/chile-lindo/chile-lindo-3.jpg',
            '/images/eventos/chile-lindo/chile-lindo-4.jpg',
            '/images/eventos/chile-lindo/chile-lindo-5.jpg',
          ]}
          alt="Festival Chile Lindo 2025 en Vitacura"
          showArrows={true}
          showDots={true}
          autoplay={false}
        >
          <div class="relative">
            <CardImage
              images={[
                '/images/eventos/chile-lindo/chile-lindo-1.jpg',
                '/images/eventos/chile-lindo/chile-lindo-2.jpg',
                '/images/eventos/chile-lindo/chile-lindo-3.jpg',
                '/images/eventos/chile-lindo/chile-lindo-4.jpg',
                '/images/eventos/chile-lindo/chile-lindo-5.jpg',
              ]}
              title="Chile Lindo 2025"
              description="Estuvimos en Vitacura llevando nuestros juegos mecánicos para que grandes y chicos disfrutaran"
              autoplayInterval={3500}
              animationType="slide"
              showDots={false}
              showArrows={true}
              height="h-80"
              overlayIntensity="medium"
              textPosition="bottom"
            />
            <!-- Icono del evento -->
            <div class="absolute top-4 left-4 z-20 rounded-full bg-white/20 p-2 backdrop-blur-sm">
              <Icon name="streamline-freehand:circus-tent" class="text-arvi-secondary h-6 w-6" />
            </div>
          </div>
        </PopUp>

        <!-- Municipalidad de Putaendo -->
        <PopUp
          images={[
            '/images/eventos/putaendo/putaendo-1.jpg',
            '/images/eventos/putaendo/putaendo-2.jpg',
            '/images/eventos/putaendo/putaendo-3.jpg',
            '/images/eventos/putaendo/putaendo-4.jpg',
          ]}
          alt="Evento Municipalidad de Putaendo"
          showArrows={true}
          showDots={true}
          autoplay={false}
        >
          <div class="relative">
            <CardImage
              images={[
                '/images/eventos/putaendo/putaendo-1.jpg',
                '/images/eventos/putaendo/putaendo-2.jpg',
                '/images/eventos/putaendo/putaendo-3.jpg',
                '/images/eventos/putaendo/putaendo-4.jpg',
              ]}
              title="Muni Putaendo"
              description="Este fin de semana estuvimos en Putaendo y fue todo un éxito. Llevamos diversión con nuestros juegos mecánicos"
              autoplayInterval={3500}
              animationType="slide"
              showDots={false}
              showArrows={true}
              height="h-80"
              overlayIntensity="medium"
              textPosition="bottom"
            />
            <!-- Icono del evento -->
            <div class="absolute top-4 left-4 z-20 rounded-full bg-white/20 p-2 backdrop-blur-sm">
              <Icon name="mdi:city" class="text-arvi-secondary h-6 w-6" />
            </div>
          </div>
        </PopUp>

        <!-- Día del Niño - Paseo Los Dominicos -->
        <PopUp
          images={[
            '/images/eventos/los-dominicos/dominicos-1.jpg',
            '/images/eventos/los-dominicos/dominicos-2.jpg',
            '/images/eventos/los-dominicos/dominicos-3.jpg',
            '/images/eventos/los-dominicos/dominicos-4.jpg',
            '/images/eventos/los-dominicos/dominicos-5.jpg',
            '/images/eventos/los-dominicos/dominicos-6.jpg',
          ]}
          alt="Día del Niño en Paseo Los Dominicos"
          showArrows={true}
          showDots={true}
          autoplay={false}
        >
          <div class="relative">
            <CardImage
              images={[
                '/images/eventos/los-dominicos/dominicos-1.jpg',
                '/images/eventos/los-dominicos/dominicos-2.jpg',
                '/images/eventos/los-dominicos/dominicos-3.jpg',
                '/images/eventos/los-dominicos/dominicos-4.jpg',
                '/images/eventos/los-dominicos/dominicos-5.jpg',
                '/images/eventos/los-dominicos/dominicos-6.jpg',
              ]}
              title="Día del Niño"
              description="Celebramos el Día del Niño en Paseo Los Dominicos con Tagadá, Barco Pirata, reloj derribador y mucho más"
              autoplayInterval={3500}
              animationType="slide"
              showDots={false}
              showArrows={true}
              height="h-80"
              overlayIntensity="medium"
              textPosition="bottom"
            />
            <!-- Icono del evento -->
            <div class="absolute top-4 left-4 z-20 rounded-full bg-white/20 p-2 backdrop-blur-sm">
              <Icon name="mdi:rocket-launch" class="text-arvi-secondary h-6 w-6" />
            </div>
          </div>
        </PopUp>

        <!-- Colegio Monte Tabor y Nazaret -->
        <PopUp
          images={[
            '/images/eventos/monte-tabor/colegio-1.jpg',
            '/images/eventos/monte-tabor/colegio-2.jpg',
            '/images/eventos/monte-tabor/colegio-3.jpg',
          ]}
          alt="Colegio Monte Tabor y Nazaret de Lo Barnechea"
          showArrows={true}
          showDots={true}
          autoplay={false}
        >
          <div class="relative">
            <CardImage
              images={[
                '/images/eventos/monte-tabor/colegio-1.jpg',
                '/images/eventos/monte-tabor/colegio-2.jpg',
                '/images/eventos/monte-tabor/colegio-3.jpg',
              ]}
              title="Monte Tabor y Nazaret"
              description="Llevamos la adrenalina al colegio con el Barco Pirata, el Tagadá y la mágica Alfombra mágica"
              autoplayInterval={3500}
              animationType="slide"
              showDots={false}
              showArrows={true}
              height="h-80"
              overlayIntensity="medium"
              textPosition="bottom"
            />
            <!-- Icono del evento -->
            <div class="absolute top-4 left-4 z-20 rounded-full bg-white/20 p-2 backdrop-blur-sm">
              <Icon name="mdi:school" class="text-arvi-secondary h-6 w-6" />
            </div>
          </div>
        </PopUp>
      </div>

      <div class="mt-12">
        <Button
          href="https://wa.me/56988082320?text=¡Hola!%20Me%20interesa%20saber%20más%20sobre%20eventos%20personalizados%20con%20ARVI.%20¿Podrían%20darme%20más%20información?"
          variant="secondary"
          size="lg"
          target="_blank"
        >
          <Icon name="lucide:star" class="mr-2 h-5 w-5" />
          ¡Contáctanos para eventos personalizados!
        </Button>
      </div>
    </div>
  </div>
</section>
