<section class="sec" id="inclusivo">
    <div class="wrap inc">
      <div class="inc-art">
        <div class="polaroid a"><img src="/img/inclusivo-3.webp" alt="Joven en silla de ruedas disfrutando del carrusel inclusivo" style="object-position:30% 50%"></div>
        <div class="polaroid b"><img src="/img/inclusivo-1.webp" alt="Carrusel inclusivo con rampa de acceso"></div>
        <div class="isa-badge" aria-hidden="true"><svg><use href="#i-isa"/></svg></div>
        <span class="star" style="width:46px;height:46px;left:58%;top:44%"><svg><use href="#i-star"/></svg></span>
