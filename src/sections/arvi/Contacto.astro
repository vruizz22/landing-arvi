---
// Sección Contacto del rediseño ARVI
---

<section class="sec contact" id="contacto">
    <div class="wrap">
      <div>
        <h2>Contacto</h2>
        <p class="lead" style="color:#4A3500;font-weight:600;margin-top:12px">Cuéntanos de tu evento. Te respondemos en menos de 24 horas.</p>
        <div class="ci">
          <div><span class="ico"><svg><use href="#i-wa"/></svg></span><span id="ph1">+569 8808 2320</span><button class="copy-btn" data-copy="+56988082320" type="button">Copiar</button></div>
          <div><span class="ico"><svg><use href="#i-phone"/></svg></span>+569 6203 1726 · +56 22 527 1281</div>
          <div><span class="ico"><svg><use href="#i-mail"/></svg></span>info@arvi.cl · arvi.juegos@gmail.com</div>
          <div><span class="ico"><svg><use href="#i-ig"/></svg></span><a href="https://www.instagram.com/arvi.cl/" target="_blank" rel="noopener" style="text-decoration:none">@arvi.cl</a></div>
        </div>
        <p style="margin-top:18px;font-weight:700;color:#4A3500">Lun a Vie 9:30 a 18:30 · Sáb y Dom 9:30 a 16:00</p>
      </div>
      <form id="quote" novalidate>
        <h3>Cotiza tu evento</h3>
        <div class="two">
          <label for="q-name">Nombre<input id="q-name" name="name" autocomplete="name" placeholder="Tu nombre" required></label>
          <label for="q-org">Institución o empresa<input id="q-org" name="org" placeholder="Municipio, colegio, productora…"></label>
        </div>
        <div class="two">
          <label for="q-date">Fecha del evento<input id="q-date" name="date" type="date"></label>
          <label for="q-place">Comuna<input id="q-place" name="place" placeholder="Ej: Maipú"></label>
        </div>
        <label for="q-type">Me interesa<select id="q-type" name="type"><option>Arriendo de juegos para un evento</option><option>ARVI Sustentable</option><option>Carrusel inclusivo</option><option>ARVI Happy (cumpleaños)</option><option>ARVI Seguro</option></select></label>
        <label for="q-msg">Detalle<textarea id="q-msg" name="msg" placeholder="Cantidad de personas, horario, juegos que te gustan…"></textarea></label>
        <button class="btn btn-g" type="submit"><svg><use href="#i-wa"/></svg>Enviar por WhatsApp</button>
        <p class="note" id="q-note" aria-live="polite">Se abrirá WhatsApp con tu mensaje armado.</p>
      </form>
      <img class="zorro-c" src="/img/zorro-pirata.webp" alt="">
    </div>
  </section>
