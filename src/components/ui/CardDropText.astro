---
import { Icon } from 'astro-icon/components'

interface Props {
  icon: string
  title: string
  subtitle: string
  dropText: string
  iconColor?: string
  bgColorHover?: string
  className?: string
}

const {
  icon,
  title,
  subtitle,
  dropText,
  iconColor = 'text-arvi-secondary',
  bgColorHover = 'bg-arvi-secondary/10 border-arvi-secondary/20 hover:bg-arvi-secondary/20',
  className = '',
} = Astro.props
---

<!-- Mantenemos exactamente la misma estructura que Card + CardContent -->
<div
  class={`group rounded-lg border border-arvi-text/10 bg-arvi-background p-4 shadow-sm hover:shadow-lg transition-all duration-500 hover:-translate-y-1 ${bgColorHover} cursor-pointer ${className}`}
>
  <!-- Contenido original (Card + CardContent) -->
  <div class="p-6 text-center">
    <div
      class={`mb-3 flex justify-center ${iconColor} group-hover:scale-110 transition-transform duration-300`}
    >
      <Icon name={icon} class="h-8 w-8" />
    </div>
    <h4 class="font-heading text-arvi-text mb-2 text-lg">{title}</h4>
    <p class="text-arvi-text/70 text-sm">
      {subtitle}
    </p>
  </div>

  <!-- Texto desplegable que empuja hacia abajo naturalmente -->
  <div
    class="max-h-0 overflow-hidden transition-all duration-500 ease-out group-hover:max-h-screen"
  >
    <div
      class="from-arvi-primary/95 to-arvi-primary/85 border-arvi-primary/20 mx-4 mb-4 rounded-b-lg border-t bg-gradient-to-t p-4 backdrop-blur-sm"
    >
      <p class="text-arvi-text animate-fade-in-up text-sm leading-relaxed">
        {dropText}
      </p>
    </div>
  </div>
</div>
