---
import LayoutArvi from '@layouts/LayoutArvi.astro'
import Icons from '@sections/arvi/Icons.astro'
import Header from '@sections/arvi/Header.astro'
import Hero from '@sections/arvi/Hero.astro'
import ComoTrabajamos from '@sections/arvi/ComoTrabajamos.astro'
import Juegos from '@sections/arvi/Juegos.astro'
import Sustentable from '@sections/arvi/Sustentable.astro'
import Inclusivo from '@sections/arvi/Inclusivo.astro'
import ArviHappy from '@sections/arvi/ArviHappy.astro'
import ArviSeguro from '@sections/arvi/ArviSeguro.astro'
import Eventos from '@sections/arvi/Eventos.astro'
import Respaldo from '@sections/arvi/Respaldo.astro'
import Testimonios from '@sections/arvi/Testimonios.astro'
import Preguntas from '@sections/arvi/Preguntas.astro'
import Contacto from '@sections/arvi/Contacto.astro'
import Footer from '@sections/arvi/Footer.astro'
import WhatsAppFlotante from '@sections/arvi/WhatsAppFlotante.astro'
---

<LayoutArvi>
  <Icons />
  <Header />
  <main id="inicio">
    <Hero />
    <ComoTrabajamos />
    <Juegos />
    <Sustentable />
    <Inclusivo />
    <ArviHappy />
    <ArviSeguro />
    <Eventos />
    <Respaldo />
    <Testimonios />
    <Preguntas />
    <Contacto />
  </main>
  <Footer />
  <WhatsAppFlotante />
</LayoutArvi>
